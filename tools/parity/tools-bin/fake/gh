#!/bin/sh
# A fake gh for parity's inbox records (T-146): it answers the two calls the inbox makes, the
# open issues and an issue's timeline, with a fixed issue set, as gh would after applying the
# call's --jq, and refuses any other call, a --jq other than the inbox's, and the timeline of an
# issue an allowed login opened, which the inbox never asks for. FAKE_GH chooses the set: "set"
# (one issue of each kind), "empty" (no open issue) or "fails" (gh exits 1).
issues_jq='.[] | select(.pull_request == null) | {number, title, author: .user.login, labels: [.labels[].name]}'
timeline_jq='.[] | select(.event == "labeled" or .event == "unlabeled") | {event, label: .label.name, actor: .actor.login}'
refuse() {
	echo "fake gh: $*" >&2
	exit 1
}
[ "$1 $2 $4" = "api --paginate --jq" ] && [ $# -eq 5 ] || refuse "not the inbox's call: $*"
case "${FAKE_GH-}" in
set | empty) ;;
fails) refuse "HTTP 502: Bad Gateway (https://api.github.com/$3)" ;;
*) refuse "FAKE_GH is \"${FAKE_GH-}\", not set, empty or fails" ;;
esac
case "$3" in
'repos/donvargax/itos/issues?state=open&per_page=100')
	[ "$5" = "$issues_jq" ] || refuse "not the inbox's issues --jq: $5"
	[ "$FAKE_GH" = empty ] && exit 0
	cat <<'JSON'
{"number":21,"title":"Opened by the allowed login","author":"donvargax","labels":["consumer-report"]}
{"number":22,"title":"A stranger's \u001b[31mred\u001b[0m title,\ta tab and a\nnew line","author":"someone-else","labels":[]}
{"number":23,"title":"Accepted by the allowed login","author":"someone-else","labels":["consumer-report","itos-accepted"]}
{"number":24,"title":"Accepted, then the label removed","author":"someone-else","labels":["consumer-report"]}
{"number":25,"title":"Accepted by another login <b>&amp;</b>   a line separator","author":"someone-else","labels":["itos-accepted"]}
{"number":26,"title":"The form's label only","author":"someone-else","labels":["consumer-report","bell\u0007label"]}
{"number":27,"title":"Accepted, removed, accepted again","author":"a-collaborator","labels":["itos-accepted"]}
{"number":28,"title":"Removed by another login after the allowed login applied it","author":"someone-else","labels":[]}
JSON
	;;
repos/donvargax/itos/issues/*/timeline\?per_page=100)
	[ "$5" = "$timeline_jq" ] || refuse "not the inbox's timeline --jq: $5"
	n=${3#repos/donvargax/itos/issues/}
	n=${n%%/*}
	case "$n" in
	22) ;;
	23) cat <<'JSON'
{"event":"labeled","label":"consumer-report","actor":"someone-else"}
{"event":"labeled","label":"itos-accepted","actor":"donvargax"}
JSON
		;;
	24) cat <<'JSON'
{"event":"labeled","label":"consumer-report","actor":"someone-else"}
{"event":"labeled","label":"itos-accepted","actor":"donvargax"}
{"event":"unlabeled","label":"itos-accepted","actor":"donvargax"}
JSON
		;;
	25) echo '{"event":"labeled","label":"itos-accepted","actor":"a-collaborator"}' ;;
	26) echo '{"event":"labeled","label":"consumer-report","actor":"someone-else"}' ;;
	27) cat <<'JSON'
{"event":"labeled","label":"itos-accepted","actor":"donvargax"}
{"event":"unlabeled","label":"itos-accepted","actor":"a-collaborator"}
{"event":"labeled","label":"itos-accepted","actor":"donvargax"}
JSON
		;;
	28) cat <<'JSON'
{"event":"labeled","label":"itos-accepted","actor":"donvargax"}
{"event":"unlabeled","label":"itos-accepted","actor":"someone-else"}
JSON
		;;
	*) refuse "the timeline of #$n, which the inbox has no cause to ask for" ;;
	esac
	;;
*) refuse "no such path: $3" ;;
esac
