#!/bin/sh
# pinned: runs a release tool at the version pinned here, fetched once into
# <git common dir>/itos/tools/<tool>-<version>/, which every worktree of the
# clone shares (T-221), or .tools/<tool>-<version>/ outside a git repository,
# from its GitHub release and checked against the SHA-256 written below before
# it is unpacked, so the machine's own copy, whatever its version, never
# decides what runs, and a replaced release asset is refused. The release
# workflow and its self-tests run them through this script alone (T-069).
#
#   tools/bin/pinned goreleaser <args>…   GoReleaser, which builds, packs and
#                                         publishes a release (.goreleaser.yaml)
#   tools/bin/pinned git-cliff <args>…    git-cliff, which lists a release's
#                                         commits by type (tools/bin/release-notes)
#   tools/bin/pinned itos-cc <args>…      itos-cc, which measures code and tests
#   tools/bin/pinned dprint <args>…       dprint, which formats the Markdown and
#                                         YAML (dprint.json, the pre-commit hook
#                                         and CI's format step, T-142)
#   tools/bin/pinned golangci-lint <args>…  golangci-lint, which lints the Go
#                                         (.golangci.yml, T-194) and runs the
#                                         fixtures of tools/bin/architecture-check
#   tools/bin/pinned --path <tool>        prints the binary's path, fetching it
#
# GoReleaser, git-cliff, dprint and golangci-lint are held to the 7-day module age rule
# (T-067); dprint's plugins are pinned by their SHA-256 in dprint.json, which
# dprint checks when it fetches them.
# itos-cc is our own built tool (ADR-0046), so it has no age wait. To move a
# pin, change its version and all four platform hashes together, from the
# release's own checksums (or the archive's SHA-256 after checking an upstream
# digest), in a build commit. Linux and macOS on amd64 and arm64, and
# golangci-lint on Windows too (Git for Windows' sh, a zip and an .exe), as
# itos-cc pins it; exit 2 elsewhere, or when a fetch or a check fails.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)

die() {
	echo "pinned: $*" >&2
	exit 2
}

[ $# -ge 1 ] || die "usage: tools/bin/pinned <tool> <args>… | tools/bin/pinned --path <tool>"
print=""
if [ "$1" = "--path" ]; then
	[ $# -eq 2 ] || die "usage: tools/bin/pinned --path <tool>"
	print=1
	shift
fi
tool=$1
shift

case "$(uname -s)-$(uname -m)" in
Linux-x86_64) platform=linux-amd64 ;;
Linux-aarch64 | Linux-arm64) platform=linux-arm64 ;;
Darwin-x86_64) platform=darwin-amd64 ;;
Darwin-arm64) platform=darwin-arm64 ;;
MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64) platform=windows-amd64 ;;
MINGW*-aarch64 | MSYS*-aarch64 | CYGWIN*-aarch64 | MINGW*-arm64 | MSYS*-arm64) platform=windows-arm64 ;;
*) die "no pinned $tool for $(uname -s)-$(uname -m)" ;;
esac

case "$tool" in
goreleaser)
	# v2.18.2, 2026-09-17.
	version=2.18.2
	case "$platform" in
	linux-amd64) asset=goreleaser_Linux_x86_64.tar.gz sum=0a96edc9d9bc594e4a41cc4d59467c182062910ab24d9d1f6dd7b667d32606d3 ;;
	linux-arm64) asset=goreleaser_Linux_arm64.tar.gz sum=a71681b29194f08f057a68cfcaa5c6b15d907a83a2622c51900c4faff828f322 ;;
	darwin-amd64) asset=goreleaser_Darwin_x86_64.tar.gz sum=5e97d6517f73a0b6f71675a2911b15d3136c03c8907650c2b18e114b1c0f5205 ;;
	darwin-arm64) asset=goreleaser_Darwin_arm64.tar.gz sum=a811ff154fe136a0cfb55d00126c151fc39ec370a663d805a9ca5547445aa70c ;;
	*) die "no pinned $tool for $platform" ;;
	esac
	url=https://github.com/goreleaser/goreleaser/releases/download/v$version/$asset
	member=goreleaser
	;;
git-cliff)
	# v2.14.2, 2026-09-18.
	version=2.14.2
	case "$platform" in
	linux-amd64) target=x86_64-unknown-linux-gnu sum=24f397c733add5390fdceee3a2088588ab0d5f944ce00d34cb7029b888cf2db4 ;;
	linux-arm64) target=aarch64-unknown-linux-gnu sum=69e208f6e4baef3a0f9b759d5f44223aa9336b86c691072a3d0c98d35a816e69 ;;
	darwin-amd64) target=x86_64-apple-darwin sum=4e647d2deb152aca1e987f225cf42b080b991dd98f3bce4027ef95446d982ac3 ;;
	darwin-arm64) target=aarch64-apple-darwin sum=a0be97e237d440d34c5e508ec21d070b2c85cbb8be48a46a56f9a4e8bd247f05 ;;
	*) die "no pinned $tool for $platform" ;;
	esac
	asset=git-cliff-$version-$target.tar.gz
	url=https://github.com/orhun/git-cliff/releases/download/v$version/$asset
	member=git-cliff-$version/git-cliff
	;;
itos-cc)
	# v0.38.0, 2026-10-25. The sums are the release's own, checksums.txt.
	version=0.38.0
	case "$platform" in
	linux-amd64) asset=itos-cc-$version-linux-amd64.tar.gz sum=37ef35e334ef7c434047723ed0bee1093076239bc3a757c99cd8636895e364c9 ;;
	linux-arm64) asset=itos-cc-$version-linux-arm64.tar.gz sum=12c1217d3b760934ea6f68fc6fd3a016dd91a4b6c9a13ece2004751b060dbde4 ;;
	darwin-amd64) asset=itos-cc-$version-darwin-amd64.tar.gz sum=08e37f644b46c9fe4bfce178f1af79a6369faea69eb1e1373cb03b461c3337f0 ;;
	darwin-arm64) asset=itos-cc-$version-darwin-arm64.tar.gz sum=515b9f43bf415fa93a487cd9cea23f3c174d4ef9d8a813045437f955724896d8 ;;
	*) die "no pinned $tool for $platform" ;;
	esac
	url=https://github.com/donvargax/itos-cc/releases/download/v$version/$asset
	member=itos-cc
	;;
dprint)
	# 0.60.1, 2026-10-03. A zip, as dprint publishes no tarball.
	version=0.60.1
	case "$platform" in
	linux-amd64) target=x86_64-unknown-linux-gnu sum=5612c587a34dfbbda37162d46755f9e8c6a4efba7950920b2a308ea84ce0886a ;;
	linux-arm64) target=aarch64-unknown-linux-gnu sum=03fd8908f9b418bdc4701347ff0527a59d1c08db2bc09a9f5d8101eb711e7fe2 ;;
	darwin-amd64) target=x86_64-apple-darwin sum=551fd5b0ce32a83682f6aaa425317db54402451a0ab66b46c0e11e17900f7db8 ;;
	darwin-arm64) target=aarch64-apple-darwin sum=b495103be1c01ba097449d73af3d76bbcef3deb291b87e9b7db6e8d12d497ef6 ;;
	*) die "no pinned $tool for $platform" ;;
	esac
	asset=dprint-$target.zip
	url=https://github.com/dprint/dprint/releases/download/$version/$asset
	member=dprint
	;;
golangci-lint)
	# v2.14.0, as itos-cc pins it; the sums are the release's own,
	# golangci-lint-2.14.0-checksums.txt.
	version=2.14.0
	case "$platform" in
	linux-amd64) sum=ab90aeb7b066f92a33415b638a50fe5344bbb75a0d32ad30cc248d88f81032ab ;;
	linux-arm64) sum=ee7ec5f3453d15ddf106fae5a4d6c71737712348a979d1fe9cd52ec7ea299bae ;;
	darwin-amd64) sum=a5667c1c3536be1740133213e1e822bfb8f0d98ea12903174d6d5f635e4ed68d ;;
	darwin-arm64) sum=5ef5f36a7147e91dc58ef9ef4d11bb7bad5ead0c76eb6c01327a73c641d1dcc3 ;;
	windows-amd64) sum=b15f903d1649283a2ab6e8d2f0c317eaf1f9f6b3763950e7e8b7e72a43dd724f ;;
	windows-arm64) sum=6399496aef883e5d2f77ea93e6e54fdd05bc2695f64071d8de0b0579cad92274 ;;
	esac
	case "$platform" in
	windows-*) asset=golangci-lint-$version-$platform.zip exe=.exe ;;
	*) asset=golangci-lint-$version-$platform.tar.gz ;;
	esac
	url=https://github.com/golangci/golangci-lint/releases/download/v$version/$asset
	member=golangci-lint-$version-$platform/golangci-lint${exe-}
	;;
*) die "no pinned tool named $tool (goreleaser, git-cliff, itos-cc, dprint, golangci-lint)" ;;
esac

# The checkout's own clone, whatever repository a caller's GIT_ variables name.
cache=$root/.tools
if common=$(cd -- "$root" && unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE && git rev-parse --git-common-dir 2>/dev/null) &&
	common=$(cd -- "$root" && cd -- "$common" && pwd); then
	cache=$common/itos/tools
fi
dir=$cache/$tool-$version
bin=$dir/$tool${exe-}
if [ ! -x "$bin" ]; then
	command -v curl >/dev/null 2>&1 || die "curl is not on the PATH, to fetch $tool $version"
	if command -v sha256sum >/dev/null 2>&1; then check="sha256sum -c -"; else check="shasum -a 256 -c -"; fi
	mkdir -p "$dir" || die "cannot make $dir"
	# Fetched beside the cache, on its file system, and renamed into place last: a fetch cut
	# short leaves no binary to run, and two worktrees fetching at once each rename a whole,
	# checked binary over the other's.
	tmp=$(mktemp -d "$cache/.fetch.XXXXXX") || die "cannot make a folder in $cache"
	trap 'rm -rf "$tmp"' EXIT
	trap 'exit 2' INT TERM
	curl -fsSL -o "$tmp/$asset" "$url" || die "cannot fetch $url"
	(cd "$tmp" && echo "$sum  $asset" | $check >/dev/null) ||
		die "$asset is not the one pinned: its SHA-256 is not $sum"
	case "$asset" in
	*.zip)
		command -v unzip >/dev/null 2>&1 || die "unzip is not on the PATH, to unpack $asset"
		unzip -q -o "$tmp/$asset" "$member" -d "$tmp" || die "$asset holds no $member"
		;;
	*) tar -xzf "$tmp/$asset" -C "$tmp" "$member" || die "$asset holds no $member" ;;
	esac
	chmod +x "$tmp/$member" || die "cannot make $member executable"
	# Windows refuses to replace an .exe that is running: another fetch's binary is as good.
	mv -f "$tmp/$member" "$bin" || [ -x "$bin" ] || die "cannot move $tool into $dir"
	rm -rf "$tmp"
	trap - EXIT INT TERM
fi
if [ -n "$print" ]; then
	echo "$bin"
	exit 0
fi
exec "$bin" "$@"
