#!/bin/sh
# pre-commit: this repository's own pre-commit hook (T-142), declared in the git config beside
# itos's commit-msg and pre-push (decision 37), so every worktree of a clone runs it. Once per
# clone, from its top folder:
#
#   git config hook.repo-pre-commit.event pre-commit
#   git config hook.repo-pre-commit.command tools/bin/pre-commit
#
# It formats what is staged and stages it again: Markdown and YAML by dprint (dprint.json says
# which files), Go by gofmt, then go vet when Go is staged, assemble -check (the command table is
# current) when a non-test Go file under internal/cli or internal/slices is, and the doc budget,
# judging the staged sizes, when a file it caps is. A file with changes left unstaged is only checked, never
# rewritten, since its working copy is not what is committed. Then, unless every staged file is
# prose or itos's own data, the dependency check when go.mod or go.sum is staged and the unit
# tests the change reaches. staticcheck is CI's (T-148).
#
# A commit by path (git commit <path>, which itos commit passes on) is made from a temporary index,
# next-index-<pid>.lock, while git writes the real index with the working copies it read before
# any hook ran, and keeps it. A file formatted and staged into the temporary index is then
# committed formatted but left staged unformatted in the real one (git status MM, bug-145), which
# the hook cannot stage into, git holding its lock. So there it formats the working copy and
# refuses the commit, and the same command, run again, commits it.
#
# git hands a hook the index it commits from (GIT_INDEX_FILE) and, in a linked worktree,
# GIT_DIR. The git commands here read and write that index on purpose; tools/bin/go-unit-tests
# drops them before any test runs, as a test's scratch repository would otherwise be this one.
set -eu
cd "$(dirname -- "$0")/../.."

# The staged files (added, copied, modified or renamed) the pathspecs match, one a line.
staged() {
	git diff --cached --name-only --diff-filter=ACMR -- "$@"
}

# gofmt -l, failing when it names a file.
gofmt_check() {
	unformatted=$(gofmt -l "$@")
	[ -z "$unformatted" ] || {
		printf '%s\n' "$unformatted"
		return 1
	}
}

# Whether this is a commit by path (the header says why it matters).
by_path() {
	case ${GIT_INDEX_FILE:-} in
	*next-index-*.lock) return 0 ;;
	esac
	return 1
}

# Formats the given files with $1 and stages them again; a file with unstaged changes is checked
# with $2 instead. Each command takes the file names last.
format() {
	fix=$1 check=$2
	shift 2
	whole="" partial=""
	for f in "$@"; do
		if git diff --quiet -- "$f"; then whole="$whole $f"; else partial="$partial $f"; fi
	done
	if [ -n "$whole" ]; then
		# shellcheck disable=SC2086 # the commands and the file lists are words: no tracked path holds a space
		$fix $whole
		if by_path; then
			# shellcheck disable=SC2086
			changed=$(git diff --name-only -- $whole)
			[ -z "$changed" ] || {
				printf '%s\n' "$changed" >&2
				echo "pre-commit: formatted the files above in the working tree, which a commit by path cannot stage; commit again" >&2
				exit 1
			}
		else
			# shellcheck disable=SC2086
			git add -- $whole
		fi
	fi
	if [ -n "$partial" ]; then
		# shellcheck disable=SC2086
		$check $partial || {
			echo "pre-commit: the files above are unformatted and have unstaged changes; format and stage them" >&2
			exit 1
		}
	fi
}

# shellcheck disable=SC2046 # the file lists are words
format "tools/bin/pinned dprint fmt --allow-no-files" "tools/bin/pinned dprint check --allow-no-files" \
	$(staged '*.md' '*.yaml' '*.yml')
gofiles=$(staged '*.go')
if [ -n "$gofiles" ]; then
	# shellcheck disable=SC2086
	format "gofmt -w" gofmt_check $gofiles
	# go vet reads packages, not files: the whole module.
	go vet ./...
	# The command table, when a file that may declare a command is staged (T-242). assemble reads
	# the working tree, not the index, so it only checks: it never writes what is committed.
	if [ -n "$(staged 'internal/cli/*.go' 'internal/slices/*.go' ':(exclude)*_test.go')" ]; then
		go run ./tools/bin/assemble -check
	fi
fi
caps=tools/bin/doc-budget/caps.json
capped=$(git show ":$caps" | grep -o '"file": *"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/')
# shellcheck disable=SC2086
if [ -n "$(git diff --cached --name-only -- "$caps" $capped)" ]; then
	go run ./tools/bin/doc-budget -index
fi

# Prose and itos's own data need no test or audit gate: Markdown, docs/**, tasks/** (the ledger
# and the work registry) and feature files. itos.yaml, the ledger, the registry and the smoke set
# are checked by the commit-msg hook (itos hook commit-msg), from the staged tree.
if [ -z "$(git diff --cached --name-only --diff-filter=ACMRD -- . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude)tasks/**' ':(exclude)features/**/*.feature')" ]; then
	exit 0
fi
# The dependency check (T-067) when go.mod or go.sum is staged, where a module can come in: no
# module younger than 7 days unless deps-check.json excepts it, then govulncheck. It asks the
# module proxy and the vulnerability database, so it needs the network, as the go get that
# changed them did. Before the unit tests, which would run a new module's code.
if [ -n "$(git diff --cached --name-only -- go.mod go.sum)" ]; then
	go run ./tools/bin/deps-check
fi
# The unit tests the staged change reaches, itos's Go packages': the packages it touches and
# those that import them (tools/bin/go-unit-tests, which pre-push runs too, through itos.yaml's
# hooks.pre_push). Nothing when no file under cmd/ or internal/, nor go.mod or go.sum, is
# staged. The whole suite is CI's.
tools/bin/go-unit-tests --cached
