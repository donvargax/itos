#!/bin/sh
# itos: the task tool's one command line, wherever it is called from. It runs
# the Go binary built from cmd/itos into .tools/bin/itos (ignored by git),
# stamped with the version tools/bin/dev-version gives this checkout from git
# describe (2.3.1-dev.5.g1234abc five commits after v2.3.0, the release's own
# at its tag; T-069), as tools/bin/build-go.ts stamps it, and records that
# version beside it in .tools/bin/itos.version. The binary is built when
# missing, rebuilt when anything under cmd/ or internal/, go.mod or go.sum is
# newer than it (a file removed counts, by its folder's time), and restamped
# when HEAD's version is not the recorded one (a commit, a tag), so the first
# call after a change pays for the build, Go's build cache keeping a restamp
# to a link, and every other call runs the binary after one git describe. It
# needs Go, only to build, and git, never Node: the binary is the itos a
# consumer runs, and this repository judges its commits with it. A build that
# fails prints one line naming it and exits 3; the old binary is never run in
# its place. `itos --help` lists the commands.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 3
dir=$root/.tools/bin
bin=$dir/itos
version=$("$root/tools/bin/dev-version" "$root")

# Prints the reason the binary cannot be built, and exits 3.
fail() {
	printf 'itos: the Go binary does not build (go build ./cmd/itos): %s\n' "$1" >&2
	[ -z "${2:-}" ] || printf '%s\n' "$2" | sed 's/^/  /' >&2
	exit 3
}

# True when the binary is missing, stamped with another version, or older
# than a file it is built from.
stale() {
	[ -x "$bin" ] || return 0
	[ "$(cat "$bin.version" 2>/dev/null)" = "$version" ] || return 0
	[ -n "$(cd "$root" && find cmd internal go.mod go.sum -newer "$bin" 2>/dev/null | head -n 1)" ]
}

if stale; then
	command -v go >/dev/null 2>&1 || fail "go is not on the PATH"
	mkdir -p "$dir" || fail "cannot create $dir"
	# Built beside the binary under a name of its own and moved over it, so
	# calls running at once never see half a binary; dated from before the
	# build, so a file changed while it ran is still newer.
	tmp=$dir/itos.$$
	touch "$tmp.start"
	out=$(cd "$root" && CGO_ENABLED=0 go build -trimpath \
		-ldflags "-s -w -X github.com/donvargax/itos/v4/internal/version.stamp=$version" \
		-o "$tmp" ./cmd/itos 2>&1)
	status=$?
	if [ "$status" -ne 0 ]; then
		rm -f "$tmp" "$tmp.start"
		# go build heads each package's errors with a "# <package>" line.
		errors=$(printf '%s\n' "$out" | grep -v '^#')
		[ -n "$errors" ] || errors="exit $status"
		fail "$(printf '%s\n' "$errors" | head -n 1)" "$(printf '%s\n' "$errors" | sed '1d')"
	fi
	# The version file after the binary: a call between the two sees the new
	# binary and the old version, and only builds again.
	touch -r "$tmp.start" "$tmp" && rm -f "$tmp.start" && mv -f "$tmp" "$bin" &&
		printf '%s\n' "$version" >"$bin.version.$$" && mv -f "$bin.version.$$" "$bin.version" ||
		fail "cannot move the build to $bin"
fi
exec "$bin" "$@"
