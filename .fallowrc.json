{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["tools/**/*.ts"],
	// The Claude Code plugin's hooks module (T-066): Claude Code loads it because the plugin's
	// hooks/hooks.json names it under "modules", which no import shows.
	"dynamicallyLoaded": ["integrations/claude-code/hooks/register.ts"],
	"ignorePatterns": ["docs/changelog/**"],
	// claude-code (and claude-code/testing) is the module Claude Code provides to a plugin's hooks
	// and tests at run time; no package of that name is installed or declared.
	"ignoreDependencies": ["yaml", "git-cliff", "ajv", "claude-code"],
	"health": {
		"thresholdOverrides": [
			{
				"files": ["tools/**"],
				"maxCrap": 1000,
				"reason": "The repository's own tooling (the self-tests, the corpus runner, the builds), verified by running it as a command, with no unit tests or coverage; cyclomatic and cognitive limits still apply."
			}
		]
	}
}
