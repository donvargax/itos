vp staged || exit $?
# Prose and itos's own data need no test or audit gate: Markdown, docs/**,
# tasks/** (the ledger and the work registry) and feature files. itos.yaml, the
# ledger, the registry and the smoke set are checked by the commit-msg hook
# (itos hook commit-msg), from the staged tree.
if [ -z "$(git diff --cached --name-only --diff-filter=ACMRD -- . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude)tasks/**' ':(exclude)features/**/*.feature')" ]; then
	exit 0
fi
# The dependency check (T-067) when go.mod or go.sum is staged, where a module
# can come in: no module younger than 7 days unless deps-check.json excepts it,
# then govulncheck. It asks the module proxy and the vulnerability database, so
# it needs the network, as the go get that changed them did. Before the unit
# tests, which would run a new module's code.
if [ -n "$(git diff --cached --name-only -- go.mod go.sum)" ]; then
	go run ./tools/bin/deps-check || exit $?
fi
# The unit tests the staged change reaches, itos's Go packages': the packages
# it touches and those that import them (tools/bin/go-unit-tests, which
# pre-push runs too, through itos.yaml's hooks.pre_push). Nothing when no file
# under cmd/ or internal/, nor go.mod or go.sum, is staged. The whole suite is
# CI's.
tools/bin/go-unit-tests --cached || exit $?
# The audit gate (new-only): skip until the repository has a first commit to diff against.
git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0
vp exec fallow audit --quiet --gate-marker pre-commit
