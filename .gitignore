dist
# Local notes, and the metrics reports written beside the tracked .metrics/mutate/ (T-141).
.tmp/
.metrics/*.json
*.log
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
# Claude Code: the agents' worktrees and each person's settings stay local.
.claude/

# What a hook or an agent leaves at the top: git's environment, a commit's message.
/.hook-git-env
/*-commit*.txt

# The Go binary tools/bin/itos builds and runs.
.tools/

# The declarations Claude Code writes beside a plugin it loads from a folder, for the editor.
integrations/claude-code/.claude-plugin/types/
